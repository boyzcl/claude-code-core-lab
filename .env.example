# Copy to .env.local for local live-model experiments.
# Never commit .env.local or real API keys.

# Generic OpenAI-compatible adapter used by src/core/model-gateway.mjs.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_FALLBACK_MODEL=

# Core 07 live model demo can also use DeepSeek or Ark-compatible settings.
AGENT_MODEL_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428

# Optional live-model runtime tuning.
AGENT_REASONING_EFFORT=medium
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_MAX_TURNS=16
